#!/usr/bin/env bash
# ==============================================================================
# YOUTUBE MUSIC TERMINAL (TUI) - FAST, FLEXIBLE & CLEAN PIPELINE (BUGFIXED)
# ==============================================================================

export SHELL="$(command -v bash)"

if [ -n "$PREFIX" ]; then
    export PATH="$PREFIX/bin:$PATH"
    YTDL_PATH="$PREFIX/bin/yt-dlp"
else
    export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
    YTDL_PATH="$(command -v yt-dlp)"
fi

CHAFA_FORMAT="auto"
[ -n "$TMUX" ] && CHAFA_FORMAT="symbols"

CONFIG_DIR="$HOME/.config/yt-fzf"
HISTORY_FILE="$CONFIG_DIR/history.txt"
mkdir -p "$CONFIG_DIR"
touch "$HISTORY_FILE"

export FZF_DEFAULT_OPTS="
  --color=bg+:#1e2a44,bg:#000000,spinner:#89b4fa,hl:#89b4fa
  --color=fg:#cdd6f4,header:#89b4fa,info:#cdd6f4,pointer:#89b4fa
  --color=marker:#89b4fa,fg+:#ffffff,prompt:#89b4fa,hl+:#89b4fa
  --border=none
  --margin=0,0
  --padding=1,1
  --layout=reverse
  --info=inline-right
  --prompt='❯ '
  --pointer='❯'
  --marker='✓'
  --bind='j:down,k:up'
"

CACHE_DIR="${TMPDIR:-/tmp}/yt-fzf-cache-$$"
mkdir -p "$CACHE_DIR"
trap 'rm -rf "$CACHE_DIR"' EXIT INT TERM

export CACHE_DIR
export HISTORY_FILE
export CHAFA_FORMAT

# ------------------------------------------------------------------------------
# HELPER: CONVERT SECONDS TO HUMAN READABLE DURATION
# ------------------------------------------------------------------------------
format_total_duration() {
    local total_sec="$1"
    local h=$((total_sec / 3600))
    local m=$(((total_sec % 3600) / 60))
    local s=$((total_sec % 60))
    
    if [ $h -gt 0 ]; then
        printf "%dh %dm %ds" $h $m $s
    elif [ $m -gt 0 ]; then
        printf "%dm %ds" $m $s
    else
        printf "%ds" $s
    fi
}
export -f format_total_duration

# ------------------------------------------------------------------------------
# TRACK INDIVIDUAL & PIPELINE LOGIC
# ------------------------------------------------------------------------------
play_single_track() {
    local line="$1"
    [ -z "$line" ] && return 0

    local id raw_title raw_artist raw_track dur_sec
    id=$(echo "$line" | awk -F'│' '{print $3}' | tr -d ' ')
    raw_title=$(echo "$line" | awk -F'│' '{print $2}' | sed -E 's/^[[:space:]]+//;s/[[:space:]]+$//')
    raw_artist=$(echo "$line" | awk -F'│' '{print $4}' | sed -E 's/^[[:space:]]+//;s/[[:space:]]+$//')
    raw_track=$(echo "$line" | awk -F'│' '{print $5}' | sed -E 's/^[[:space:]]+//;s/[[:space:]]+$//')
    dur_sec=$(echo "$line" | awk -F'│' '{print $6}' | tr -d ' ')
    [[ "$dur_sec" =~ ^[0-9]+$ ]] || dur_sec=0
    [ -z "$id" ] && return 0

    if ! grep -qF "$id" "$HISTORY_FILE" 2>/dev/null; then echo "$line" >> "$HISTORY_FILE"; fi

    local thumb="$CACHE_DIR/$id.jpg"
    local lrc_raw="$CACHE_DIR/${id}_raw.lrc"
    local lrc_final="$CACHE_DIR/${id}.lrc"
    local lrc_json="$CACHE_DIR/${id}.json"
    local stream_tmp="$CACHE_DIR/${id}.stream"

    # --------------------------------------------------------------------------
    # 0. MULAI FETCH AUDIO STREAM DI BACKGROUND (PARALEL DENGAN LIRIK & THUMBNAIL)
    #    Sebelumnya ini baru jalan setelah semua proses lirik selesai, jadi
    #    latency-nya numpuk. Sekarang jalan bareng.
    # --------------------------------------------------------------------------
    ( yt-dlp --print "%(url)s" -f bestaudio "https://www.youtube.com/watch?v=$id" \
        > "$stream_tmp" 2>/dev/null ) &
    local stream_pid=$!

    # --------------------------------------------------------------------------
    # 1. CLEANING METADATA & PARSING (FIXED REGEX)
    # --------------------------------------------------------------------------

    local title="$raw_title"
    local artist="$raw_artist"
    local pure_title pure_artist

    artist=$(printf '%s\n' "$artist" | sed -E \
        -e 's/[[:space:]]*-[[:space:]]*topic[[:space:]]*$//gi' \
        -e 's/[[:space:]]+(vevo|official|records|channel)[[:space:]]*$//gi' \
        -e 's/^[[:space:]]+//;s/[[:space:]]+$//')

    if [[ -z "$artist" || "$artist" == "Unknown" ]] && [[ "$title" == *" - "* ]]; then
        artist="${title%% - *}"
        title="${title#*" - "}"
        artist=$(printf '%s\n' "$artist" | sed -E 's/^[[:space:]]+//;s/[[:space:]]+$//')
        title=$(printf '%s\n' "$title" | sed -E 's/^[[:space:]]+//;s/[[:space:]]+$//')
    fi

    pure_title="$title"
    pure_artist="$artist"

    local is_modified=0
    if echo "$raw_title" | grep -Ei -q '(sped[ -]?up|speed[ -]?up|slowed|reverb)'; then
        is_modified=1
    fi

    # --------------------------------------------------------------------------
    # 2. PEMROSESAN LIRIK (DILAKUKAN SEBELUM RENDER NOW PLAYING)
    # --------------------------------------------------------------------------
    rm -f "$lrc_json" "$lrc_raw" "$lrc_final"
    local lyric_status_msg=""
    local lyric_approx_warning=0

    if [ "$is_modified" -eq 1 ]; then
        lyric_status_msg="\e[33m󰅖 Lyrics: Disabled (Sped Up/Slowed/Reverb)\e[0m"
    else
        # Tahap 1: Exact Metadata
        if [ -n "$pure_artist" ] && [ "$pure_artist" != "Unknown" ]; then
            curl -sS -m 1 -G --data-urlencode "track_name=$pure_title" \
                           --data-urlencode "artist_name=$pure_artist" \
                           "https://lrclib.net/api/search" > "$lrc_json" 2>/dev/null

            if jq -e 'type == "array" and length > 0' "$lrc_json" >/dev/null 2>&1; then
                pick_synced_lyrics "$lrc_json" "$dur_sec" > "$lrc_raw" 2>/dev/null
            fi
        fi

        # Tahap 2: Fallback Judul SAJA
        if [ ! -s "$lrc_raw" ] && [ -n "$pure_title" ]; then
            curl -sS -m 1 -G --data-urlencode "q=$pure_title" "https://lrclib.net/api/search" > "$lrc_json" 2>/dev/null
            if jq -e 'type == "array" and length > 0' "$lrc_json" >/dev/null 2>&1; then
                pick_synced_lyrics "$lrc_json" "$dur_sec" > "$lrc_raw" 2>/dev/null
            fi
        fi

        # Tahap 3: Fallback Query (Judul + Artist)
        if [ ! -s "$lrc_raw" ]; then
            local search_query="$pure_title"
            [ -n "$pure_artist" ] && [ "$pure_artist" != "Unknown" ] && search_query="$pure_title $pure_artist"

            curl -sS -m 1 -G --data-urlencode "q=$search_query" "https://lrclib.net/api/search" > "$lrc_json" 2>/dev/null
            if jq -e 'type == "array" and length > 0' "$lrc_json" >/dev/null 2>&1; then
                pick_synced_lyrics "$lrc_json" "$dur_sec" > "$lrc_raw" 2>/dev/null
            fi
        fi

        # Tahap 4: Fallback Judul Tanpa Kurung
        if [ ! -s "$lrc_raw" ]; then
            local clean_fallback_title=$(echo "$pure_title" | sed -E 's/\([^)]*\)//g; s/\[[^]]*\]//g; s/^[[:space:]]+//;s/[[:space:]]+$//')
            if [ -n "$clean_fallback_title" ]; then
                curl -sS -m 1 -G --data-urlencode "q=$clean_fallback_title $pure_artist" "https://lrclib.net/api/search" > "$lrc_json" 2>/dev/null
                if jq -e 'type == "array" and length > 0' "$lrc_json" >/dev/null 2>&1; then
                    pick_synced_lyrics "$lrc_json" "$dur_sec" > "$lrc_raw" 2>/dev/null
                fi
            fi
        fi

        # Tahap 5: Best-effort
        if [ ! -s "$lrc_raw" ] && jq -e 'type == "array" and length > 0' "$lrc_json" >/dev/null 2>&1; then
            pick_synced_lyrics "$lrc_json" "$dur_sec" 1 > "$lrc_raw" 2>/dev/null
            if [ -s "$lrc_raw" ]; then
                lyric_approx_warning=1
            fi
        fi

        # Penentuan String Indikator Status Lirik
        if [ -s "$lrc_raw" ]; then
            if [ "$lyric_approx_warning" -eq 1 ]; then
                lyric_status_msg="\e[33m󰎆 Lyrics: Synced (Approx. Duration)\e[0m"
            else
                lyric_status_msg="\e[32m󰎆 Lyrics: Synced (LRCLIB)\e[0m"
            fi
        else
            lyric_status_msg="\e[90m󰅖 Lyrics: Unavailable\e[0m"
        fi
    fi

    echo -ne "\e[r"; clear
    if [ ! -f "$thumb" ] || [ ! -s "$thumb" ]; then curl -s -m 1 -L "https://img.youtube.com/vi/$id/mqdefault.jpg" -o "$thumb" 2>/dev/null; fi

    # TAMPILAN NOW PLAYING VERSI UPDATED
    echo -e "\n\e[38;2;137;180;250m󰐊 NOW PLAYING\e[0m"
    echo -e "\e[90m   q Skip   Q/Ctrl+q Back   z/x Sub Delay\e[0m\n"

    if [ -s "$thumb" ]; then
        chafa --format=kitty --size 32x10 "$thumb" 2>/dev/null ||
            echo -e "  \e[31m󰅖 Thumbnail unavailable\e[0m"
    else
        echo -e "  \e[31m󰅖 Thumbnail unavailable\e[0m"
    fi

    echo
    echo -e "  \e[1;37m$title\e[0m"
    echo -e "  \e[38;2;137;180;250m$artist\e[0m"
    echo -e "  $lyric_status_msg"
    echo
    echo -e "  \e[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m"
    echo -e "  \e[90mPlaying from YouTube\e[0m"
    echo

    # AMBIL HASIL AUDIO STREAM (sudah jalan di background sejak awal fungsi)
    wait "$stream_pid" 2>/dev/null
    local stream_url
    stream_url=$(head -n 1 "$stream_tmp" 2>/dev/null)

    if [ -z "$stream_url" ]; then
        echo -e "  \e[31m󰅖 Unable to get audio stream\e[0m"
        return 1
    fi

    local -a mpv_opts=()
    if [ -s "$lrc_raw" ]; then
        cp "$lrc_raw" "$lrc_final"
        mpv_opts+=("--sub-file=$lrc_final" "--sid=1")
    fi

    mpv --no-video --display-tags=no --msg-level=ffmpeg=fatal,cplayer=warn \
        --profile=fast --hwdec=auto --audio-buffer=2 \
        --term-osd-bar --term-osd-bar-chars=" ━╸─ " \
        --sid=1 --sub-visibility=yes \
        --input-conf=<(echo -e "q quit 0\nQ quit 2\nCtrl+q quit 2") \
        "${mpv_opts[@]}" "$stream_url"
    local exit_code=$?
    echo -ne "\e[r"; clear
    return $exit_code
}

pick_synced_lyrics() {
    local json_file="$1" target_dur="$2" force="${3:-0}"
    [[ "$target_dur" =~ ^[0-9]+$ ]] || target_dur=0
    [[ "$force" =~ ^[0-9]+$ ]] || force=0
    jq -r --argjson dur "$target_dur" --argjson force "$force" '
        map(select((.syncedLyrics // "") != ""))
        | map(. + {_diff: (if $dur > 0 then ((.duration - $dur) | fabs) else 0 end)})
        | sort_by(._diff)
        | .[0]
        | select(. != null and ($force == 1 or $dur == 0 or ._diff <= 3))
        | .syncedLyrics // empty
    ' "$json_file" 2>/dev/null
}
export -f pick_synced_lyrics
export -f play_single_track

AUTOPLAY_MODE=0

# ------------------------------------------------------------------------------
# MAIN LOOP
# ------------------------------------------------------------------------------
while true; do
    clear
    echo
    echo -e "\e[38;2;137;180;250m󰎆  \e[1;37mYOUTUBE MUSIC\e[0m"
    echo -e "\e[90m   Search • Discover • Listen\e[0m"
    echo
    echo -ne "\e[38;2;203;166;247m❯\e[0m "
    
    read -r -n 1 FIRST_CHAR

    if [[ "$FIRST_CHAR" == "q" || "$FIRST_CHAR" == "Q" ]]; then
        echo -e "\n\n  \e[32m󰗠 Sampai jumpa!\e[0m"
        break
    fi

    if [ -z "$FIRST_CHAR" ]; then
        QUERY=""
    else
        read -r REST_INPUT
        QUERY="${FIRST_CHAR}${REST_INPUT}"
    fi

    # --- PROSES HISTORY ---
    if [ -z "$QUERY" ]; then
        if [ ! -s "$HISTORY_FILE" ]; then
            echo -e "\n  \e[31m󰅖 History masih kosong!\e[0m"
            sleep 1
            continue
        fi
        FORMATTED_DATA=$(tac "$HISTORY_FILE")
    else
        # --- PROSES SEARCH YOUTUBE ---
        echo -e "\n  \e[38;2;249;226;175m󱎫 Fetching metadata...\e[0m"
        
        if [[ "$QUERY" =~ ^https?://.*list=.* ]]; then
            TARGET="$QUERY"
        else
            TARGET="ytsearch25:$QUERY"
        fi

        YT_DATA=$(yt-dlp "$TARGET" \
            --flat-playlist \
            --skip-download \
            --match-filter "!is_live" \
            --dump-json 2>/dev/null | \
            jq -r '[.id, .title, (.uploader // "Unknown"), (.track // .title), (.duration // 0)] | @tsv')

        [ -z "$YT_DATA" ] && continue

        FORMATTED_DATA=$(echo "$YT_DATA" | awk -F'\t' '{
            sec = $5;
            if (sec == 0) {
                dur = "--:--";
            } else {
                h = int(sec / 3600);
                m = int((sec % 3600) / 60);
                s = sec % 60;
                if (h > 0)
                    dur = sprintf("%02d:%02d:%02d", h, m, s);
                else
                    dur = sprintf("%02d:%02d", m, s);
            }
            printf "%-8s │ %s │ %s │ %s │ %s │ %s\n", dur, $2, $1, $3, $4, sec
        }')
    fi

    TOTAL_TRACKS=$(echo "$FORMATTED_DATA" | wc -l | tr -d ' ')
    
    # --- HITUNG DURAIS TOTAL PLAYLIST ---
    TOTAL_SECONDS=$(echo "$FORMATTED_DATA" | awk -F'│' '{sum += $6} END {print sum}')
    TOTAL_DURATION_STR=$(format_total_duration "${TOTAL_SECONDS:-0}")

    PREVIEW_CMD="id=\$(echo {} | awk -F'│' '{print \$3}' | tr -d ' '); \
                 thumb=\"$CACHE_DIR/\$id.jpg\"; \
                 if [ ! -f \"\$thumb\" ]; then \
                     curl -s -m 1 -L \"https://img.youtube.com/vi/\$id/mqdefault.jpg\" -o \"\$thumb\" 2>/dev/null; \
                 fi; \
                 if [ -s \"\$thumb\" ]; then \
                     chafa --format=kitty --size 30x9 \"\$thumb\" 2>/dev/null; \
                 else \
                     echo -e \"\n  \e[31m󰅖 Loading thumbnail...\e[0m\"; \
                 fi"

    while true; do
        if [ "$AUTOPLAY_MODE" -eq 1 ]; then
            STATUS_STR="󰐎 AUTOPLAY"
        else
            STATUS_STR="󰐎 MANUAL"
        fi

        HEADER_INFO="$TOTAL_TRACKS TRACKS ($TOTAL_DURATION_STR) $STATUS_STR  TAB QUEUE  ALT+A TOGGLE"

        FZF_OUT=$(echo "$FORMATTED_DATA" | fzf \
            --multi \
            --border=none \
            --header="$HEADER_INFO" \
            --header-first \
            --no-scrollbar \
            --layout=reverse \
            --preview-window="top:38%:noborder" \
            --preview="$PREVIEW_CMD" \
            --prompt=" " \
            --pointer="❯" \
            --marker="✓" \
            --expect=alt-a)

        [ -z "$FZF_OUT" ] && break

        KEY_PRESSED=$(echo "$FZF_OUT" | head -n 1)
        SELECTED_LINES=$(echo "$FZF_OUT" | tail -n +2)

        if [ "$KEY_PRESSED" = "alt-a" ]; then
            if [ "$AUTOPLAY_MODE" -eq 1 ]; then
                AUTOPLAY_MODE=0
            else
                AUTOPLAY_MODE=1
            fi
            continue
        fi

        [ -z "$SELECTED_LINES" ] && continue

        SELECTED_COUNT=$(echo "$SELECTED_LINES" | wc -l | tr -d ' ')

        if [ "$SELECTED_COUNT" -gt 1 ]; then
            while IFS= read -r line; do
                play_single_track "$line"
                status=$?
                if [ $status -eq 2 ]; then break; fi
            done <<< "$SELECTED_LINES"
        elif [ "$AUTOPLAY_MODE" -eq 1 ]; then
            SELECTED_ID=$(echo "$SELECTED_LINES" | awk -F'│' '{print $3}' | tr -d ' ')
            START_LINE=$(echo "$FORMATTED_DATA" | grep -n "$SELECTED_ID" | cut -d: -f1)
            PLAYLIST_QUEUE=$(echo "$FORMATTED_DATA" | tail -n +"$START_LINE")

            while IFS= read -r line; do
                play_single_track "$line"
                status=$?
                if [ $status -eq 2 ]; then break; fi
            done <<< "$PLAYLIST_QUEUE"
        else
            play_single_track "$SELECTED_LINES"
        fi
    done
done
