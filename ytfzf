#!/usr/bin/env bash
# ==============================================================================
# YOUTUBE MUSIC TERMINAL (TUI) - FAST, FLEXIBLE & CLEAN PIPELINE (LYRICS FIXED)
# ==============================================================================

export SHELL="$(command -v bash)"

if [ -n "$PREFIX" ]; then
    export PATH="$PREFIX/bin:$PATH"
    YTDL_PATH="$PREFIX/bin/yt-dlp"
else
    export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
    YTDL_PATH="$(command -v yt-dlp)"
fi

CHAFA_FORMAT="auto"
[ -n "$TMUX" ] && CHAFA_FORMAT="symbols"

CONFIG_DIR="$HOME/.config/yt-fzf"
HISTORY_FILE="$CONFIG_DIR/history.txt"
mkdir -p "$CONFIG_DIR"
touch "$HISTORY_FILE"

export FZF_DEFAULT_OPTS="
  --color=bg+:#1e2a44,bg:#000000,spinner:#89b4fa,hl:#89b4fa
  --color=fg:#cdd6f4,header:#89b4fa,info:#cdd6f4,pointer:#89b4fa
  --color=marker:#89b4fa,fg+:#ffffff,prompt:#89b4fa,hl+:#89b4fa
  --border=none
  --margin=0,0
  --padding=1,1
  --layout=reverse
  --info=inline-right
  --prompt='❯ '
  --pointer='❯'
  --marker='✓'
  --bind='j:down,k:up'
"

CACHE_DIR="${TMPDIR:-/tmp}/yt-fzf-cache-$$"
mkdir -p "$CACHE_DIR"
trap 'rm -rf "$CACHE_DIR"' EXIT INT TERM

export CACHE_DIR
export HISTORY_FILE
export CHAFA_FORMAT

# ------------------------------------------------------------------------------
# TRACK INDIVIDUAL & PIPELINE LOGIC
# ------------------------------------------------------------------------------
play_single_track() {
    local line="$1"
    [ -z "$line" ] && return 0

    local id raw_title raw_artist raw_track
    id=$(echo "$line" | awk -F'│' '{print $3}' | tr -d ' ')
    raw_title=$(echo "$line" | awk -F'│' '{print $2}')
    raw_artist=$(echo "$line" | awk -F'│' '{print $4}')
    raw_track=$(echo "$line" | awk -F'│' '{print $5}')
    [ -z "$id" ] && return 0

    if ! grep -qF "$id" "$HISTORY_FILE" 2>/dev/null; then echo "$line" >> "$HISTORY_FILE"; fi

    local thumb="$CACHE_DIR/$id.jpg"
    local lrc_raw="$CACHE_DIR/${id}_raw.lrc"
    local lrc_final="$CACHE_DIR/${id}.lrc"
    local lrc_json="$CACHE_DIR/${id}.json"

    # 1. CLEANING METADATA DENGAN REGEX PRESET LEBIH LUAS
    local title artist pure_title pure_artist

    # Hapus noise/tag dari Title
    title=$(printf '%s\n' "$raw_title" | sed -E \
        -e 's/[[:space:]]*\([^)]*(official|music|video|audio|lyric|lyrics|hd|4k|topic|vevo|visualizer|full song|reupload|edit|remix|slowed|reverb|speed|sped up)[^)]*\)//gi' \
        -e 's/[[:space:]]*\[[^]]*(official|music|video|audio|lyric|lyrics|hd|4k|topic|vevo|visualizer|full song|reupload|edit|remix|slowed|reverb|speed|sped up)[^]]*\]//gi' \
        -e 's/^[[:space:]]+//;s/[[:space:]]+$//')

    # Hapus noise/tag dari Artist
    artist=$(printf '%s\n' "$raw_artist" | sed -E \
        -e 's/[[:space:]]*-[[:space:]]*topic[[:space:]]*$//gi' \
        -e 's/[[:space:]]+(vevo|official|records|channel)[[:space:]]*$//gi' \
        -e 's/^[[:space:]]+//;s/[[:space:]]+$//')

    # Pemisahan jika judul mengandung format "Artist - Title"
    if [[ "$title" == *" - "* ]]; then
        artist=$(printf '%s\n' "$title" | cut -d'-' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        title=$(printf '%s\n' "$title" | cut -d'-' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    fi

    # Ekstraksi Kata Kunci Murni untuk LRCLIB
    pure_title=$(printf '%s\n' "$title" | sed -E \
        -e 's/[[:space:]]*\([^)]*\)//g' \
        -e 's/[[:space:]]*\[[^]]*\]//g' \
        -e 's/[[:space:]]+(feat\.|ft\.).*$//gi' \
        -e 's/[[:space:]]+(slowed|reverb|remix|sped up|nightcore|edit|pitch).*$//gi' \
        -e 's/^[[:space:]]+//;s/[[:space:]]+$//')

    pure_artist=$(printf '%s\n' "$artist" | sed -E \
        -e 's/[[:space:]]*\([^)]*\)//g' \
        -e 's/^[[:space:]]+//;s/[[:space:]]+$//')

    [ -z "$pure_title" ] && pure_title="$raw_title"

    # Deteksi lagu modifikasi (Hanya untuk notasi visual, tidak memblokir lirik)
    local is_modified=0
    if echo "$raw_title" | grep -Ei -q 'slowed|speed|sped[ -]?up|nightcore|reverb|remix|edit|pitch|digicore'; then
        is_modified=1
    fi

    echo -ne "\e[r"; clear
    if [ ! -f "$thumb" ] || [ ! -s "$thumb" ]; then curl -s -m 3 -L "https://img.youtube.com/vi/$id/mqdefault.jpg" -o "$thumb" 2>/dev/null; fi
    echo -e "\n \e[38;2;137;180;250;1m󰐊 NOW PLAYING\e[0m \e[90m(q: Skip | Q / Ctrl+q: Quit to FZF | z/x: Sub Delay)\e[0m\n"
    if [ -s "$thumb" ]; then chafa --format=kitty --size 26x7 "$thumb" 2>/dev/null || echo -e "  \e[31m󰅖 Thumbnail Render Failed\e[0m\n"; else echo -e "  \e[31m󰅖 Thumbnail Unavailable\e[0m\n"; fi
    echo -e " "
    echo -e " \e[1;35m󰎈 Title  :\e[0m \e[1;37m$title\e[0m"
    echo -e " \e[1;34m󰠃 Artist :\e[0m \e[0;36m$artist\e[0m\n"

    # FETCH AUDIO STREAM VIA YT-DLP
    read -r stream_url actual_duration < <(yt-dlp --print "%(url)s %(duration)s" -f bestaudio "https://www.youtube.com/watch?v=$id" 2>/dev/null)
    [ -z "$stream_url" ] && { echo -e "  \e[31m󰅖 Unable to get audio stream\e[0m"; sleep 1.5; return 1; }

    rm -f "$lrc_json" "$lrc_raw" "$lrc_final"

    # 2. PEMROSESAN LIRIK MULTI-STAGE FALLBACK
    if [ "$is_modified" -eq 1 ]; then
        echo -e " \e[33m󰅖 Track is modified (Slowed/Remix). Fetching original lyrics...\e[0m"
    fi

    # Tahap 1: Search Query "Title + Artist"
    local search_query="$pure_title"
    if [ -n "$pure_artist" ] && [ "$pure_artist" != "Unknown" ]; then
        search_query="$pure_title $pure_artist"
    fi

    curl -sS -m 5 -G --data-urlencode "q=$search_query" "https://lrclib.net/api/search" > "$lrc_json" 2>/dev/null

    if jq -e 'type == "array" and length > 0' "$lrc_json" >/dev/null 2>&1; then
        jq -r 'map(select((.syncedLyrics // "") != "")) | .[0].syncedLyrics // empty' "$lrc_json" > "$lrc_raw" 2>/dev/null
    fi

    # Tahap 2: Fallback Search Hanya Judul Lagu (jika Uploader/Artist YouTube bukan nama penyanyi asli)
    if [ ! -s "$lrc_raw" ] && [ -n "$pure_title" ]; then
        curl -sS -m 5 -G --data-urlencode "q=$pure_title" "https://lrclib.net/api/search" > "$lrc_json" 2>/dev/null
        if jq -e 'type == "array" and length > 0' "$lrc_json" >/dev/null 2>&1; then
            jq -r 'map(select((.syncedLyrics // "") != "")) | .[0].syncedLyrics // empty' "$lrc_json" > "$lrc_raw" 2>/dev/null
        fi
    fi

    # Tahap 3: Fallback Exact GET (khusus untuk lagu non-modifikasi dengan pencocokan durasi)
    if [ ! -s "$lrc_raw" ] && [ "$is_modified" -eq 0 ] && [ -n "$pure_artist" ] && [[ "$actual_duration" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        curl -sS -m 5 -G --data-urlencode "track_name=$pure_title" \
                       --data-urlencode "artist_name=$pure_artist" \
                       --data-urlencode "duration=$actual_duration" \
                       "https://lrclib.net/api/get" > "$lrc_json" 2>/dev/null
        jq -r '.syncedLyrics // empty' "$lrc_json" > "$lrc_raw" 2>/dev/null
    fi

    local -a mpv_opts=()
    if [ -s "$lrc_raw" ]; then
        cp "$lrc_raw" "$lrc_final"
        mpv_opts+=("--sub-file=$lrc_final" "--sid=1")
    else
        echo -e " \e[33m󰅖 No synced-lyrics match found in LRCLIB\e[0m"
        echo -e " \e[90m   Audio tetap diputar tanpa lirik.\e[0m\n"
        sleep 1.0
    fi


    mpv --no-video --display-tags=no --msg-level=ffmpeg=fatal,cplayer=warn --term-osd-bar --term-osd-bar-chars=" ━╸─ " --osd-level=1  --profile=fast --hwdec=auto-safe --audio-buffer=2 --input-conf=<(echo -e "q quit 0\nQ quit 2\nCtrl+q quit 2") "${mpv_opts[@]}" "$stream_url"
    local exit_code=$?
    echo -ne "\e[r"; clear
    return $exit_code
}

export -f play_single_track

AUTOPLAY_MODE=0

# ------------------------------------------------------------------------------
# MAIN LOOP
# ------------------------------------------------------------------------------
while true; do
    clear
    echo -e "\e[38;2;137;180;250m╭──────────────────────────────────────────────╮\e[0m"
    echo -e "\e[38;2;137;180;250m│  󰗃  \e[1;37mYOUTUBE MUSIC TERMINAL\e[0m                   \e[38;2;137;180;250m│\e[0m"
    echo -e "\e[38;2;137;180;250m╰──────────────────────────────────────────────╯\e[0m"
    echo -e "  \e[90m(Enter: History | q: Quit Script)\e[0m"
    echo -ne "  \e[38;2;203;166;247m❯\e[0m Search Track / Playlist : "
    
    read -r -n 1 FIRST_CHAR

    if [[ "$FIRST_CHAR" == "q" || "$FIRST_CHAR" == "Q" ]]; then
        echo -e "\n\n  \e[32m󰗠 Sampai jumpa!\e[0m"
        break
    fi

    if [ -z "$FIRST_CHAR" ]; then
        QUERY=""
    else
        read -r REST_INPUT
        QUERY="${FIRST_CHAR}${REST_INPUT}"
    fi

    # --- PROSES HISTORY ---
    if [ -z "$QUERY" ]; then
        if [ ! -s "$HISTORY_FILE" ]; then
            echo -e "\n  \e[31m󰅖 History masih kosong!\e[0m"
            sleep 1.5
            continue
        fi
        FORMATTED_DATA=$(tac "$HISTORY_FILE")
    else
        # --- PROSES SEARCH YOUTUBE ---
        echo -e "\n  \e[38;2;249;226;175m󱎫 Fetching metadata...\e[0m"
        
        if [[ "$QUERY" =~ ^https?://.*list=.* ]]; then
            TARGET="$QUERY"
        else
            TARGET="ytsearch25:$QUERY"
        fi

        YT_DATA=$(yt-dlp "$TARGET" \
            --flat-playlist \
            --skip-download \
            --match-filter "!is_live" \
            --dump-json 2>/dev/null | \
            jq -r '[.id, .title, (.uploader // "Unknown"), (.track // .title), (.duration // 0)] | @tsv')

        [ -z "$YT_DATA" ] && continue

        FORMATTED_DATA=$(echo "$YT_DATA" | awk -F'\t' '{
            sec = $5;
            if (sec == 0) {
                dur = "--:--";
            } else {
                h = int(sec / 3600);
                m = int((sec % 3600) / 60);
                s = sec % 60;
                if (h > 0)
                    dur = sprintf("%02d:%02d:%02d", h, m, s);
                else
                    dur = sprintf("%02d:%02d", m, s);
            }
            printf "%-8s │ %s │ %s │ %s │ %s\n", dur, $2, $1, $3, $4
        }')
    fi

    TOTAL_TRACKS=$(echo "$FORMATTED_DATA" | wc -l | tr -d ' ')

    PREVIEW_CMD="id=\$(echo {} | awk -F'│' '{print \$3}' | tr -d ' '); \
                 thumb=\"$CACHE_DIR/\$id.jpg\"; \
                 if [ ! -f \"\$thumb\" ]; then \
                     curl -s -m 2 -L \"https://img.youtube.com/vi/\$id/mqdefault.jpg\" -o \"\$thumb\" 2>/dev/null; \
                 fi; \
                 if [ -s \"\$thumb\" ]; then \
                     chafa --format=sixel --size 30x9 \"\$thumb\" 2>/dev/null; \
                 else \
                     echo -e \"\n  \e[31m󰅖 Loading thumbnail...\e[0m\"; \
                 fi"

    while true; do
        if [ "$AUTOPLAY_MODE" -eq 1 ]; then
            STATUS_STR="[AUTOPLAY: ON]"
        else
            STATUS_STR="[AUTOPLAY: OFF]"
        fi

        HEADER_INFO=" TRACKS: $TOTAL_TRACKS | $STATUS_STR | [TAB: Select Queue] [ALT+A: Toggle Autoplay]"

        FZF_OUT=$(echo "$FORMATTED_DATA" | fzf \
          --multi \
          --border=none \
          --header="$HEADER_INFO" \
          --preview-window="top:35%:noborder" \
          --preview="$PREVIEW_CMD" \
          --expect=alt-a)

        [ -z "$FZF_OUT" ] && break

        KEY_PRESSED=$(echo "$FZF_OUT" | head -n 1)
        SELECTED_LINES=$(echo "$FZF_OUT" | tail -n +2)

        if [ "$KEY_PRESSED" = "alt-a" ]; then
            if [ "$AUTOPLAY_MODE" -eq 1 ]; then
                AUTOPLAY_MODE=0
            else
                AUTOPLAY_MODE=1
            fi
            continue
        fi

        [ -z "$SELECTED_LINES" ] && continue

        SELECTED_COUNT=$(echo "$SELECTED_LINES" | wc -l | tr -d ' ')

        if [ "$SELECTED_COUNT" -gt 1 ]; then
            while IFS= read -r line; do
                play_single_track "$line"
                status=$?
                if [ $status -eq 2 ]; then break; fi
            done <<< "$SELECTED_LINES"
        elif [ "$AUTOPLAY_MODE" -eq 1 ]; then
            SELECTED_ID=$(echo "$SELECTED_LINES" | awk -F'│' '{print $3}' | tr -d ' ')
            START_LINE=$(echo "$FORMATTED_DATA" | grep -n "$SELECTED_ID" | cut -d: -f1)
            PLAYLIST_QUEUE=$(echo "$FORMATTED_DATA" | tail -n +"$START_LINE")

            while IFS= read -r line; do
                play_single_track "$line"
                status=$?
                if [ $status -eq 2 ]; then break; fi
            done <<< "$PLAYLIST_QUEUE"
        else
            play_single_track "$SELECTED_LINES"
        fi
    done
done
