#!/usr/bin/env bash
# ==============================================================================
# YOUTUBE MUSIC TERMINAL (TUI) - PLAYLIST, AUTOPLAY, QUEUE & DYNAMIC LRC PIPELINE
# ==============================================================================

export SHELL="$(command -v bash)"

if [ -n "$PREFIX" ]; then
    export PATH="$PREFIX/bin:$PATH"
    YTDL_PATH="$PREFIX/bin/yt-dlp"
else
    export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
    YTDL_PATH="$(command -v yt-dlp)"
fi

CHAFA_FORMAT="auto"
[ -n "$TMUX" ] && CHAFA_FORMAT="symbols"

# Folder Konfigurasi & History
CONFIG_DIR="$HOME/.config/yt-fzf"
HISTORY_FILE="$CONFIG_DIR/history.txt"
mkdir -p "$CONFIG_DIR"
touch "$HISTORY_FILE"

export FZF_DEFAULT_OPTS="
  --color=bg+:#1e2a44,bg:#000000,spinner:#89b4fa,hl:#89b4fa
  --color=fg:#cdd6f4,header:#89b4fa,info:#cdd6f4,pointer:#89b4fa
  --color=marker:#89b4fa,fg+:#ffffff,prompt:#89b4fa,hl+:#89b4fa
  --border=none
  --margin=0,0
  --padding=1,1
  --layout=reverse
  --info=inline-right
  --prompt='❯ '
  --pointer='❯'
  --marker='✓'
  --bind='j:down,k:up'
"

CACHE_DIR="${TMPDIR:-/tmp}/yt-fzf-cache-$$"
mkdir -p "$CACHE_DIR"
trap 'rm -rf "$CACHE_DIR"' EXIT INT TERM

export CACHE_DIR
export HISTORY_FILE
export CHAFA_FORMAT

# ------------------------------------------------------------------------------
# LRC TRANSFORMER (TRANSFORM TIMESTAMP BERDASARKAN SCALE FACTOR)
# ------------------------------------------------------------------------------
transform_lrc() {
    local input_lrc="$1"
    local output_lrc="$2"
    local factor="$3"

    awk -v f="$factor" '
    {
        if (match($0, /^\[([0-9]+):([0-9]+)\.([0-9]+)\](.*)/, m)) {
            min = m[1] + 0
            sec = m[2] + 0
            ms  = m[3] + 0
            
            total_sec = (min * 60 + sec + (ms / 100)) * f
            
            new_min = int(total_sec / 60)
            rem_sec = total_sec % 60
            new_sec = int(rem_sec)
            new_ms  = int((rem_sec - new_sec) * 100)
            
            printf "[%02d:%02d.%02d]%s\n", new_min, new_sec, new_ms, m[4]
        } else {
            print $0
        }
    }' "$input_lrc" > "$output_lrc"
}

# ------------------------------------------------------------------------------
# TREK INDIVIDUAL & PIPELINE SEHAT LOGIC
# ------------------------------------------------------------------------------
play_single_track() {
    local line="$1"
    [ -z "$line" ] && return 0

    local id=$(echo "$line" | awk -F'│' '{print $3}' | tr -d ' ')
    local raw_title=$(echo "$line" | awk -F'│' '{print $2}')
    local raw_artist=$(echo "$line" | awk -F'│' '{print $4}')
    local raw_track=$(echo "$line" | awk -F'│' '{print $5}')
    
    # Simpan ke History (Cegah duplikat berurutan)
    if ! grep -q "$id" "$HISTORY_FILE" 2>/dev/null; then
        echo "$line" >> "$HISTORY_FILE"
    fi

    local thumb="$CACHE_DIR/$id.jpg"
    local lrc_raw="$CACHE_DIR/${id}_raw.lrc"
    local lrc_final="$CACHE_DIR/${id}_scaled.lrc"
    local lrc_json="$CACHE_DIR/$id.json"

    # --- 1. CLEANING & SMART IDENTITY EXTRACTION ---
    local title=$(echo "$raw_title" | sed -E -e 's/\(.*\)|\[.*\]//g' -e 's/(official|music|video|audio|lyric|lyrics|hd|4k|- topic|vevo|remastered|full album)//gi' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    local artist=$(echo "$raw_artist" | sed -E -e 's/- topic|vevo|official|various artists/ /gi' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    
    # Jika artist kosong / generic, coba ekstrak dari judul YouTube (Artist - Title)
    if [ -z "$artist" ] && [[ "$title" == *" - "* ]]; then
        artist=$(echo "$title" | cut -d'-' -f1 | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        title=$(echo "$title" | cut -d'-' -f2- | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    fi

    # Pembersihan ekstra untuk PURE IDENTITY (Hapus versi modifier & feat/ft)
    local pure_title=$(echo "$title" | sed -E -e 's/(speed up|spedd up|nightcore|slowed|reverb|remix|pitch|edit|feat\..*|ft\..*)//gi' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    local pure_track=$(echo "$raw_track" | sed -E -e 's/\(.*\)|\[.*\]//g' -e 's/(official|music|video|audio|lyric|lyrics|hd|4k|- topic|vevo|speed up|spedd up|nightcore|slowed|reverb|remix|pitch|edit|feat\..*|ft\..*)//gi' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -z "$pure_track" ] && pure_track="$pure_title"

    echo -ne "\e[r"
    clear

    if [ ! -f "$thumb" ] || [ ! -s "$thumb" ]; then
        curl -s -m 3 -L "https://img.youtube.com/vi/$id/mqdefault.jpg" -o "$thumb" 2>/dev/null
    fi

    echo -e "\n \e[38;2;137;180;250;1m󰐊 NOW PLAYING\e[0m \e[90m(q: Skip | Q / Ctrl+q: Quit to FZF)\e[0m\n"

    if [ -s "$thumb" ]; then
        chafa --format=kitty --size 26x7 "$thumb" 2>/dev/null || echo -e "  \e[31m󰅖 Thumbnail Render Failed\e[0m\n"
    else
        echo -e "  \e[31m󰅖 Thumbnail Unavailable\e[0m\n"
    fi

    echo -e " \e[1;35m󰎈 Title  :\e[0m \e[1;37m$title\e[0m"
    echo -e " \e[1;34m󰠃 Artist :\e[0m \e[0;36m$artist\e[0m\n"

    # --- 2. FETCH PURE IDENTITY LYRICS FROM LRCLIB (PRECISE MATCH ONLY) ---
    (
        # Tier 1: Match Track Name + Artist
        curl -s -G --data-urlencode "track_name=$pure_track" --data-urlencode "artist_name=$artist" "https://lrclib.net/api/get" > "$lrc_json"
        
        # Tier 2: Match Title + Artist
        if [ ! -s "$lrc_json" ] || grep -q '"error"' "$lrc_json" 2>/dev/null; then
            curl -s -G --data-urlencode "track_name=$pure_title" --data-urlencode "artist_name=$artist" "https://lrclib.net/api/get" > "$lrc_json"
        fi

        # Tier 3: Search Query (Artist + Track)
        if [ ! -s "$lrc_json" ] || grep -q '"error"' "$lrc_json" 2>/dev/null; then
            curl -s -G --data-urlencode "q=$artist $pure_track" "https://lrclib.net/api/search" > "$lrc_json"
        fi

        # Ekstrak syncedLyrics jika ditemukan
        if grep -q '"syncedLyrics"' "$lrc_json" 2>/dev/null; then
            jq -r 'if type == "array" then (map(select(.syncedLyrics != null and .syncedLyrics != "")) | .[0].syncedLyrics // empty) else (.syncedLyrics // empty) end' "$lrc_json" 2>/dev/null > "$lrc_raw"
        else
            rm -f "$lrc_raw"
        fi
    ) &

    STREAM_URL=$(yt-dlp -g -f bestaudio "https://www.youtube.com/watch?v=$id" 2>/dev/null)
    ACTUAL_DURATION=$(yt-dlp --print duration "https://www.youtube.com/watch?v=$id" 2>/dev/null)
    wait

    # --- 3. DYNAMIC TIME-SCALE & TIMESTAMP REWRITE ---
    local -a mpv_opts=()
    if [ -s "$lrc_raw" ]; then
        ORIGINAL_DURATION=$(jq -r 'if type == "array" then (map(select(.syncedLyrics != null and .syncedLyrics != "")) | .[0].duration // empty) else (.duration // empty) end' "$lrc_json" 2>/dev/null)

        USE_LRC=1
        if [ -n "$ORIGINAL_DURATION" ] && [ -n "$ACTUAL_DURATION" ] && [ "$ORIGINAL_DURATION" != "null" ]; then
            # Formula Scale Factor: Durasi YouTube / Durasi Original LRCLIB
            SCALE_FACTOR=$(awk "BEGIN {if ($ORIGINAL_DURATION > 0) print $ACTUAL_DURATION / $ORIGINAL_DURATION; else print 1.0}")
            
            # Threshold safety check (Toleransi rasio 0.5x sampai 2.0x)
            IS_VALID=$(awk "BEGIN {if ($SCALE_FACTOR >= 0.50 && $SCALE_FACTOR <= 2.00) print 1; else print 0}")
            
            if [ "$IS_VALID" -eq 1 ]; then
                transform_lrc "$lrc_raw" "$lrc_final" "$SCALE_FACTOR"
            else
                USE_LRC=0
            fi
        else
            cp "$lrc_raw" "$lrc_final"
        fi

        if [ "$USE_LRC" -eq 1 ] && [ -s "$lrc_final" ]; then
            mpv_opts+=(
                "--sub-file=$lrc_final"
                "--sid=1"
            )
        fi
    fi

    mpv --no-video \
        --display-tags=no \
        --msg-level=ffmpeg=fatal,cplayer=warn \
        --term-osd-bar \
        --term-osd-bar-chars=" ━╸─ " \
        --osd-level=1 \
        --input-conf=<(echo -e "q quit 0\nQ quit 2\nCtrl+q quit 2") \
        "${mpv_opts[@]}" "$STREAM_URL"
    
    local exit_code=$?

    echo -ne "\e[r"
    clear

    return $exit_code
}

export -f play_single_track

AUTOPLAY_MODE=0

# ------------------------------------------------------------------------------
# MAIN LOOP
# ------------------------------------------------------------------------------
while true; do
    clear
    echo -e "\e[38;2;137;180;250m╭──────────────────────────────────────────────╮\e[0m"
    echo -e "\e[38;2;137;180;250m│  󰗃  \e[1;37mYOUTUBE MUSIC TERMINAL\e[0m                   \e[38;2;137;180;250m│\e[0m"
    echo -e "\e[38;2;137;180;250m╰──────────────────────────────────────────────╯\e[0m"
    echo -e "  \e[90m(Enter: History | q: Quit Script)\e[0m"
    echo -ne "  \e[38;2;203;166;247m❯\e[0m Search Track / Playlist : "
    
    read -r -n 1 FIRST_CHAR

    if [[ "$FIRST_CHAR" == "q" || "$FIRST_CHAR" == "Q" ]]; then
        echo -e "\n\n  \e[32m󰗠 Sampai jumpa!\e[0m"
        break
    fi

    if [ -z "$FIRST_CHAR" ]; then
        QUERY=""
    else
        read -r REST_INPUT
        QUERY="${FIRST_CHAR}${REST_INPUT}"
    fi

    # --- PROSES HISTORY ---
    if [ -z "$QUERY" ]; then
        if [ ! -s "$HISTORY_FILE" ]; then
            echo -e "\n  \e[31m󰅖 History masih kosong!\e[0m"
            sleep 1.5
            continue
        fi
        FORMATTED_DATA=$(tac "$HISTORY_FILE")
    else
        # --- PROSES SEARCH YOUTUBE ---
        echo -e "\n  \e[38;2;249;226;175m󱎫 Fetching metadata...\e[0m"
        
        if [[ "$QUERY" =~ ^https?://.*list=.* ]]; then
            TARGET="$QUERY"
        else
            TARGET="ytsearch25:$QUERY"
        fi

        YT_DATA=$(yt-dlp "$TARGET" \
            --flat-playlist \
            --skip-download \
            --match-filter "!is_live" \
            --dump-json 2>/dev/null | \
            jq -r '[.id, .title, (.uploader // "Unknown"), (.track // .title), (.duration // 0)] | @tsv')

        [ -z "$YT_DATA" ] && continue

        FORMATTED_DATA=$(echo "$YT_DATA" | awk -F'\t' '{
            sec = $5;
            if (sec == 0) {
                dur = "--:--";
            } else {
                h = int(sec / 3600);
                m = int((sec % 3600) / 60);
                s = sec % 60;
                if (h > 0)
                    dur = sprintf("%02d:%02d:%02d", h, m, s);
                else
                    dur = sprintf("%02d:%02d", m, s);
            }
            printf "%-8s │ %s │ %s │ %s │ %s\n", dur, $2, $1, $3, $4
        }')
    fi

    TOTAL_TRACKS=$(echo "$FORMATTED_DATA" | wc -l | tr -d ' ')

    PREVIEW_CMD="id=\$(echo {} | awk -F'│' '{print \$3}' | tr -d ' '); \
                 thumb=\"$CACHE_DIR/\$id.jpg\"; \
                 if [ ! -f \"\$thumb\" ]; then \
                     curl -s -m 2 -L \"https://img.youtube.com/vi/\$id/mqdefault.jpg\" -o \"\$thumb\" 2>/dev/null; \
                 fi; \
                 if [ -s \"\$thumb\" ]; then \
                     chafa --format=sixel --size 30x9 \"\$thumb\" 2>/dev/null; \
                 else \
                     echo -e \"\n  \e[31m󰅖 Loading thumbnail...\e[0m\"; \
                 fi"

    while true; do
        if [ "$AUTOPLAY_MODE" -eq 1 ]; then
            STATUS_STR="[AUTOPLAY: ON]"
        else
            STATUS_STR="[AUTOPLAY: OFF]"
        fi

        HEADER_INFO=" TRACKS: $TOTAL_TRACKS | $STATUS_STR | [TAB: Select Queue] [ALT+A: Toggle Autoplay]"

        FZF_OUT=$(echo "$FORMATTED_DATA" | fzf \
          --multi \
          --border=none \
          --header="$HEADER_INFO" \
          --preview-window="top:35%:noborder" \
          --preview="$PREVIEW_CMD" \
          --expect=alt-a)

        [ -z "$FZF_OUT" ] && break

        KEY_PRESSED=$(echo "$FZF_OUT" | head -n 1)
        SELECTED_LINES=$(echo "$FZF_OUT" | tail -n +2)

        if [ "$KEY_PRESSED" = "alt-a" ]; then
            if [ "$AUTOPLAY_MODE" -eq 1 ]; then
                AUTOPLAY_MODE=0
            else
                AUTOPLAY_MODE=1
            fi
            continue
        fi

        [ -z "$SELECTED_LINES" ] && continue

        SELECTED_COUNT=$(echo "$SELECTED_LINES" | wc -l | tr -d ' ')

        if [ "$SELECTED_COUNT" -gt 1 ]; then
            echo "$SELECTED_LINES" | while IFS= read -r line; do
                play_single_track "$line"
                status=$?
                if [ $status -eq 2 ]; then break; fi
            done
        elif [ "$AUTOPLAY_MODE" -eq 1 ]; then
            SELECTED_ID=$(echo "$SELECTED_LINES" | awk -F'│' '{print $3}' | tr -d ' ')
            START_LINE=$(echo "$FORMATTED_DATA" | grep -n "$SELECTED_ID" | cut -d: -f1)
            PLAYLIST_QUEUE=$(echo "$FORMATTED_DATA" | tail -n +"$START_LINE")

            echo "$PLAYLIST_QUEUE" | while IFS= read -r line; do
                play_single_track "$line"
                status=$?
                if [ $status -eq 2 ]; then break; fi
            done
        else
            play_single_track "$SELECTED_LINES"
        fi
    done
done
