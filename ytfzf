    local title=$(echo "$line" | awk -F'│' '{print $2}' | sed -E -e 's/\(.*\)|\[.*\]//g' -e 's/(official|music|video|audio|lyric|lyrics|hd|4k|- topic|vevo)//gi' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    local artist=$(echo "$line" | awk -F'│' '{print $4}' | sed -E -e 's/- topic|vevo|official//gi' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    local track_name=$(echo "$line" | awk -F'│' '{print $5}' | sed -E -e 's/\(.*\)|\[.*\]//g' -e 's/(official|music|video|audio|lyric|lyrics|hd|4k|- topic|vevo)//gi' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    
    local thumb="$CACHE_DIR/$id.jpg"
    local lrc_file="$CACHE_DIR/$id.lrc"

    echo -ne "\e[r"
    clear

    if [ ! -f "$thumb" ] || [ ! -s "$thumb" ]; then
        curl -s -m 3 -L "https://img.youtube.com/vi/$id/mqdefault.jpg" -o "$thumb" 2>/dev/null
    fi

    echo -e "\n \e[38;2;137;180;250;1m󰐊 NOW PLAYING\e[0m\n"

    if [ -s "$thumb" ]; then
        chafa --format sixel --size 26x7 "$thumb"
